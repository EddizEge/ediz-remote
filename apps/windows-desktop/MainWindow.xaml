<Window x:Class="EdizRemote.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Ediz Remote"
        Width="1320"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F2F5F9">
    <Grid>
        <wv2:WebView2 x:Name="WebView" Visibility="Hidden" />

        <Grid x:Name="LoadingPanel" Background="#F2F5F9">
            <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="72" Height="72" Margin="0,0,0,24"
                        HorizontalAlignment="Center" Background="#1458D9" CornerRadius="16">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="27" FontWeight="SemiBold">ER</TextBlock>
                </Border>
                <TextBlock HorizontalAlignment="Center" Foreground="#172033"
                           FontSize="25" FontWeight="SemiBold">Ediz Remote</TextBlock>
                <TextBlock x:Name="LoadingText" Margin="0,10,0,22" HorizontalAlignment="Center"
                           Foreground="#687287" FontSize="14" TextAlignment="Center"
                           TextWrapping="Wrap">Windows uygulaması hazırlanıyor...</TextBlock>
                <ProgressBar x:Name="LoadingProgress" Height="4" IsIndeterminate="True"
                             Foreground="#1458D9" />
                <Button x:Name="RetryLoadingButton" Width="160" Height="44" Margin="0,18,0,0"
                        HorizontalAlignment="Center" Visibility="Collapsed"
                        Background="#1458D9" BorderThickness="0" Foreground="White"
                        FontWeight="SemiBold" Click="RetryLoadingButton_Click">
                    Yeniden dene
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
