# Virgülle ayrılmış STUN URL listesi. Boş bırakılırsa TURN yapılandırılmalıdır.
ICE_STUN_URLS=stun:stun.cloudflare.com:3478

# Coturn public adresleri. İlk deployment UDP ve TCP 3478 uçlarını açar.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp

# Coturn static-auth-secret ile aynı, uzun ve rastgele dosya. Depoya eklemeyin.
# Rootful Linux/Pi production'da iki secret dosyası UID 1000 ve mode 0400 olmalıdır.
TURN_SHARED_SECRET_FILE_HOST=./secrets/turn-shared-secret.key
# Coturn Compose dosyasına göre aynı dosyanın yolu. Özel path kullanıyorsanız
# iki değeri de aynı dosyaya işaret eden mutlak yollarla değiştirin.
COTURN_SHARED_SECRET_FILE_HOST=../../secrets/turn-shared-secret.key

# TURN kimlik doğrulama realm'i ve public IPv4 adresi.
TURN_REALM=turn.example.com
TURN_EXTERNAL_IP=auto

# VPS public arayüzü veya NAT arkasındaki Pi'nin sabit LAN IPv4 adresi.
TURN_RELAY_IP=192.168.1.10

# Public güvenlik duvarında açılacak UDP relay port aralığı.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Production coturn ham IP/kullanıcı adı loglamaz; yalnız izole testlerde stdout açılır.
TURN_LOG_OUTPUT=discard

# İstemciye verilen HMAC kimlik bilgisinin ömrü: 60-86400 saniye.
TURN_CREDENTIAL_TTL_SECONDS=3600

# WebSocket için same-origin arayüze ek izin verilen origin listesi.
# Windows WebView2 uygulaması varsayılan olarak bu güvenilir sanal origin'i kullanır.
SIGNALING_ALLOWED_ORIGINS=https://remote.edizegemercan.com.tr,https://app.ediz-remote.local

# Yalnız servis Cloudflare Tunnel arkasında ve doğrudan portu public değilse açın.
# false iken istemcinin gönderdiği CF-Connecting-IP başlığı yok sayılır.
TRUST_CLOUDFLARE_CONNECTING_IP=true

# Signaling kaynak kotaları. 96 session / 256 socket oranı reconnect takeover için
# boş bağlantı payı bırakır; production kapasitesi ölçülmeden yükseltmeyin.
SIGNALING_MAX_CONNECTIONS=256
SIGNALING_MAX_CONNECTIONS_PER_IP=16
SIGNALING_MAX_SESSIONS=96
SIGNALING_MAX_SESSIONS_PER_IP=4

# Signaling güvenlik audit'i production Compose'ta varsayılan olarak açıktır.
# Anahtar TURN secret'tan ayrı, en az 32 bayt olmalı ve repoya eklenmemelidir.
# Örnek üretim ve izin komutları README ile docs/SECURITY_AUDIT.md içindedir.
SIGNALING_AUDIT_ENABLED=true
SIGNALING_AUDIT_HMAC_KEY_FILE_HOST=./secrets/signaling-audit-hmac.key
SIGNALING_AUDIT_RETENTION_DAYS=7
EDIZ_REMOTE_BUILD_ID=ediz-remote@0.1.0

# Production Compose için bu değeri elle veya mutable tag ile vermeyin.
# `npm run security:containers` başarılıysa platform dizininde deployment.env üretir;
# yalnız `npm run security:container:deploy` ile application+coturn için doğrulayıp tüketin.
# EDIZ_REMOTE_APP_IMAGE=sha256:<audited-local-image-id>
# EDIZ_REMOTE_COTURN_IMAGE=sha256:<audited-local-coturn-image-id>
